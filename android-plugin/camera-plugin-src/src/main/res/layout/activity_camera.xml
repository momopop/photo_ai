<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- 全屏预览（center-crop，不留黑边） -->
    <TextureView
        android:id="@+id/texture_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <!-- 画幅裁切遮罩 -->
    <com.photoai.camera.RatioOverlayView
        android:id="@+id/ratio_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 三分法网格线 -->
    <com.photoai.camera.GridOverlayView
        android:id="@+id/grid_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- 快门白色闪烁层 -->
    <View
        android:id="@+id/shutter_flash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:visibility="gone" />

    <!-- 顶部控制栏 -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="top"
        android:background="#CC000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="返回"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back"
            android:tint="#FFFFFF" />

        <!-- 画幅选择器（居中填充） -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_ratio_full"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="全幅"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:background="@drawable/bg_ratio_btn" />

            <View android:layout_width="4dp" android:layout_height="1dp" />

            <TextView
                android:id="@+id/btn_ratio_43"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="4:3"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:background="@drawable/bg_ratio_btn_selected" />

            <View android:layout_width="4dp" android:layout_height="1dp" />

            <TextView
                android:id="@+id/btn_ratio_169"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="16:9"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:background="@drawable/bg_ratio_btn" />

            <View android:layout_width="4dp" android:layout_height="1dp" />

            <TextView
                android:id="@+id/btn_ratio_11"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="1:1"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:background="@drawable/bg_ratio_btn" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_flash"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="闪光灯"
            android:padding="10dp"
            android:src="@drawable/ic_flash_auto"
            android:tint="#FFFFFF" />

    </LinearLayout>

    <!-- 变焦比例标签（始终可见，点击可切换预设） -->
    <TextView
        android:id="@+id/tv_zoom"
        android:layout_width="64dp"
        android:layout_height="32dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="128dp"
        android:background="@drawable/bg_zoom_badge"
        android:gravity="center"
        android:text="1.0×"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- 底部控制栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="112dp"
        android:layout_gravity="bottom"
        android:background="#CC000000"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingBottom="8dp">

        <!-- 相册按钮（展示最新拍摄缩略图） -->
        <ImageButton
            android:id="@+id/btn_gallery"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="相册"
            android:padding="12dp"
            android:src="@drawable/ic_photo_library"
            android:tint="#FFFFFF" />

        <!-- 拍照按钮 -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center">

            <ImageButton
                android:id="@+id/btn_capture"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_capture_button"
                android:contentDescription="拍照"
                android:padding="0dp"
                android:src="@drawable/ic_camera_shutter" />
        </FrameLayout>

        <!-- 切换前后摄 -->
        <ImageButton
            android:id="@+id/btn_switch"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="切换摄像头"
            android:padding="12dp"
            android:src="@drawable/ic_camera_switch"
            android:tint="#FFFFFF" />

    </LinearLayout>

</FrameLayout>
